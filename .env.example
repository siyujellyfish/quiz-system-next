# Database runtime
# Local Docker PostgreSQL uses postgres-js because @neondatabase/serverless
# only connects through Neon's remote proxy.
DATABASE_DRIVER=postgres-js
DATABASE_URL="postgres://user:password@host:port/db-name"

# Neon / Vercel Marketplace:
# - omit DATABASE_DRIVER so runtime defaults to @neondatabase/serverless
# - DATABASE_URL is the pooled application connection
# - DATABASE_URL_UNPOOLED is preferred by Drizzle Kit migrations
DATABASE_URL_UNPOOLED="postgres://user:password@host:port/db-name"

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-please

# ChatGPT account linking
# Configure these with the OAuth/OIDC values issued for your approved OpenAI integration.
CHATGPT_OAUTH_AUTHORIZE_URL=""
CHATGPT_OAUTH_TOKEN_URL=""
CHATGPT_OAUTH_USERINFO_URL=""
CHATGPT_OAUTH_CLIENT_ID=""
CHATGPT_OAUTH_CLIENT_SECRET=""
CHATGPT_OAUTH_SCOPE="openid profile email offline_access"

# Base64-encoded 32-byte key used to encrypt stored OAuth tokens.
# Example: openssl rand -base64 32
CHATGPT_TOKEN_ENCRYPTION_KEY=""

# Optional. Only configure an OpenAI-approved endpoint/scope that returns
# Codex rate-limit usage. The profile page remains usable when omitted.
CHATGPT_CODEX_USAGE_URL=""
